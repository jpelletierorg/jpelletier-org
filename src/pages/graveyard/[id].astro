---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = (await getCollection('graveyard')).filter(p => !p.data.draft);
  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Base title={`${item.data.title} — Graveyard`}>

  <div class="detail-hero">
    <div class="detail-inner">
      <a href="/" class="back">&larr; BACK</a>
      <div class="detail-header">
        <h1 class="detail-title grave-title">{item.data.title}</h1>
        <span class="badge dead-badge">DEAD</span>
      </div>
      <div class="epitaph">"{item.data.epitaph}"</div>
    </div>
  </div>

  <div class="grid-section">
    <div class="section-label">Post-Mortem</div>
    <div class="detail-content">
      <Content />
    </div>
  </div>

</Base>

<style>
  .detail-hero {
    padding: 3rem 2rem 2.5rem;
    border-bottom: 4px solid var(--border);
  }
  .detail-inner { max-width: 1100px; margin: 0 auto; }
  .back {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg-dim);
    text-decoration: none;
    border: 2px solid var(--border);
    padding: 0.4em 0.8em;
    display: inline-block;
    margin-bottom: 2rem;
    transition: all 0.1s;
  }
  .back:hover {
    background: var(--red);
    border-color: var(--red);
    color: var(--bg);
  }
  .detail-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .detail-title {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--fg);
    line-height: 1;
  }
  .grave-title {
    text-decoration: line-through;
    text-decoration-color: var(--red);
    text-decoration-thickness: 3px;
    color: var(--fg-dim);
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.3em 0.8em;
  }
  .dead-badge {
    background: var(--border);
    color: var(--fg-dim);
  }
  .epitaph {
    font-size: 1.2rem;
    color: var(--fg-dim);
    font-style: italic;
    margin-top: 0.5rem;
  }

  .detail-content {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--fg);
    max-width: 800px;
  }
  .detail-content :global(h2) {
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--red);
    margin: 2rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }
  .detail-content :global(h3) {
    font-size: 1rem;
    font-weight: 900;
    color: var(--fg);
    margin: 1.5rem 0 0.5rem;
  }
  .detail-content :global(p) { margin-bottom: 1rem; }
  .detail-content :global(ul), .detail-content :global(ol) {
    margin: 0 0 1rem 1.5rem;
  }
  .detail-content :global(li) { margin-bottom: 0.5rem; }
  .detail-content :global(img) {
    max-width: 100%;
    border: 2px solid var(--border);
    margin: 1.5rem 0;
  }
  .detail-content :global(blockquote) {
    border-left: 4px solid var(--red);
    padding-left: 1rem;
    color: var(--fg-dim);
    font-style: italic;
    margin: 1.5rem 0;
  }

  @media (max-width: 700px) {
    .detail-hero { padding: 2rem 1.25rem; }
    .detail-title { font-size: 2rem; }
  }
</style>
