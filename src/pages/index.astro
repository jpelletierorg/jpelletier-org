---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).filter(p => !p.data.draft).sort((a, b) => a.data.order - b.data.order);
const graveyardItems = (await getCollection('graveyard')).filter(p => !p.data.draft).sort((a, b) => a.data.order - b.data.order);
const activeProjects = projects.filter(p => p.data.status === 'active');
---

<Base title="Home">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-inner">
      <h1 class="hero-name">
        JONATHAN<span>PELLETIER</span>
      </h1>
      <p class="hero-tagline">User: create a 100k MRR business. Make no mistakes.</p>
    </div>
  </div>

  <!-- IDENTITY -->
  <div class="grid-section">
    <div class="identity-row">
      <img src="/avatar.jpg" alt="Jonathan Pelletier">
      <div class="identity-text">
        <div class="links-row">
          <a href="https://x.com/jpelletierorg" target="_blank" rel="noopener">X / Twitter</a>
          <a href="https://github.com/jpelletierorg" target="_blank" rel="noopener">GitHub</a>
          <a href="mailto:j@jpelletier.org">Email</a>
        </div>
      </div>
    </div>
  </div>

  <!-- MANIFESTO -->
  <div class="grid-section">
    <div class="section-label">About</div>
    <div class="manifesto">
      <strong>This is an AI doomerism laboratory.</strong>
      The fast takeoff is imminent. This is one of probably many attempts from an average software engineer (read mid) to ride the shockwave. Prompts to MRR with minimal human babysitting before the
      window of opportunity closes forever and the unprepared become permanent proles. 
    </div>
  </div>

  <!-- CURRENT BUILDS -->
  <div class="grid-section">
    <div class="section-label">Cogitating ideas</div>
    {activeProjects.length > 0 ? (
      <div class="builds-grid">
        {activeProjects.map((project) => (
          <a href={`/projects/${project.id}`} class="build-link">
            <div class="build-block">
              <div class="build-header">
                <span class="build-name">{project.data.title}</span>
                <span class="badge">ACTIVE</span>
              </div>
              <div class="build-oneliner">{project.data.oneliner}</div>
              <div class="build-desc">{project.data.description}</div>
              <div class="build-footer">
                {project.data.milestones.length > 0 && (
                  <span class="build-milestone">Latest: {project.data.milestones[project.data.milestones.length - 1].text}</span>
                )}
                <span class="build-arrow">&rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="builds-empty">The lab is quiet. Something is brewing.</div>
    )}
  </div>

  <!-- GRAVEYARD -->
  <div class="grid-section">
    <div class="section-label">Graveyard</div>
    {graveyardItems.length > 0 ? (
      <div class="grave-grid">
        {graveyardItems.map((item) => (
          <a href={`/graveyard/${item.id}`} class="grave-link">
            <div class="grave-item">
              <div class="grave-name">{item.data.title}</div>
              <div class="grave-epitaph">"{item.data.epitaph}"</div>
              <div class="grave-arrow">Read post-mortem &rarr;</div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="grave-empty">Nothing here yet. Long may it last.</div>
    )}
  </div>

</Base>

<style>
  .hero {
    padding: 4rem 2rem 3rem;
    border-bottom: 4px solid var(--red);
  }
  .hero-inner { max-width: 1100px; margin: 0 auto; }
  .hero-name {
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .hero-name span { display: block; color: var(--red); }
  .hero-tagline {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--fg-dim);
    margin-top: 1.5rem;
    border-left: 4px solid var(--red);
    padding-left: 1rem;
  }

  .identity-row {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .identity-row img {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border: 4px solid var(--red);
    filter: contrast(1.15) grayscale(20%);
    flex-shrink: 0;
  }
  .identity-text { flex: 1; min-width: 280px; }
  .links-row { display: flex; gap: 0; }
  .links-row a {
    color: var(--fg);
    text-decoration: none;
    font-weight: 900;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.2rem;
    border: 2px solid var(--border);
    transition: all 0.1s;
  }
  .links-row a + a { border-left: none; }
  .links-row a:hover {
    background: var(--red);
    border-color: var(--red);
    color: var(--bg);
    text-decoration: none;
  }

  .manifesto {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.7;
    color: var(--fg);
    font-weight: 400;
    max-width: 800px;
  }
  .manifesto strong { color: var(--red); font-weight: 900; }

  .builds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .build-link { text-decoration: none; color: inherit; display: block; }
  .build-block {
    border: 4px solid var(--red);
    padding: 2rem;
    background: rgba(224, 80, 48, 0.03);
    transition: background 0.15s;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .build-link:hover .build-block { background: rgba(224, 80, 48, 0.08); }
  .build-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .build-name {
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--red);
    color: var(--bg);
    padding: 0.3em 0.8em;
  }
  .build-oneliner {
    font-size: 1.1rem;
    color: var(--red);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .build-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--fg);
    flex: 1;
  }
  .build-footer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 2px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .build-milestone {
    font-size: 0.75rem;
    color: var(--fg-dim);
    font-weight: 400;
  }
  .build-arrow {
    font-size: 1.2rem;
    color: var(--fg-dim);
    transition: transform 0.15s;
  }
  .build-link:hover .build-arrow { transform: translateX(4px); color: var(--red); }

  .grave-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  .grave-link {
    text-decoration: none;
    color: inherit;
    display: flex;
  }
  .grave-item {
    padding: 1.5rem;
    border: 2px solid var(--border);
    transition: border-color 0.15s;
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  .grave-epitaph { flex: 1; }
  .grave-link:hover .grave-item { border-color: var(--red); }
  .grave-name {
    font-size: 1rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg);
    margin-bottom: 0.5rem;
    position: relative;
    width: fit-content;
  }
  .grave-name::after {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    width: 100%; height: 2px;
    background: var(--red);
  }
  .grave-epitaph {
    font-size: 0.85rem;
    color: var(--fg-dim);
    font-style: italic;
    line-height: 1.5;
  }
  .grave-arrow {
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-top: 0.75rem;
    transition: color 0.15s;
  }
  .grave-link:hover .grave-arrow { color: var(--red); }
  .builds-empty {
    font-size: 0.9rem;
    color: var(--fg-dim);
    font-style: italic;
    padding: 1.5rem;
    border: 2px solid var(--border);
  }
  .grave-empty {
    font-size: 0.9rem;
    color: var(--fg-dim);
    font-style: italic;
    padding: 1.5rem;
    border: 2px solid var(--border);
  }

  @media (max-width: 700px) {
    .hero { padding: 2.5rem 1.25rem 2rem; }
    .builds-grid { grid-template-columns: 1fr; }
    .build-block { padding: 1.25rem; }
    .identity-row img { width: 140px; height: 140px; }
    .grave-grid { grid-template-columns: 1fr; }
    .grave-link { display: block; }
    .links-row { flex-wrap: wrap; }
    .links-row a { flex: 1; text-align: center; min-width: 100px; }
    .links-row a + a { border-left: 2px solid var(--border); }
  }
</style>
