---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(p => !p.data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const milestones = project.data.milestones || [];
---

<Base title={project.data.title}>

  <div class="detail-hero">
    <div class="detail-inner">
      <a href="/" class="back">&larr; BACK</a>
      <div class="detail-header">
        <h1 class="detail-title">{project.data.title}</h1>
        <span class="badge">{project.data.status.toUpperCase()}</span>
      </div>
      <div class="detail-oneliner">{project.data.oneliner}</div>
      <div class="detail-meta">
        {project.data.demo && (
          <a href={project.data.demo} target="_blank" rel="noopener" class="meta-link">Live Demo &rarr;</a>
        )}
        {project.data.repo && (
          <a href={project.data.repo} target="_blank" rel="noopener" class="meta-link">Source Code &rarr;</a>
        )}
      </div>
    </div>
  </div>

  {milestones.length > 0 && (
    <div class="grid-section">
      <div class="section-label">Milestones</div>
      <div class="milestones">
        {milestones.map((m, i) => (
          <div class="milestone">
            <div class="milestone-marker">
              <div class={`milestone-dot ${i === milestones.length - 1 ? 'latest' : ''}`}></div>
              {i < milestones.length - 1 && <div class="milestone-line"></div>}
            </div>
            <div class="milestone-content">
              <span class="milestone-date">{m.date}</span>
              <span class="milestone-text">{m.text}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="grid-section">
    <div class="section-label">About</div>
    <div class="detail-desc">{project.data.description}</div>
  </div>

  <div class="grid-section">
    <div class="section-label">Details</div>
    <div class="detail-content">
      <Content />
    </div>
  </div>

</Base>

<style>
  .detail-hero {
    padding: 3rem 2rem 2.5rem;
    border-bottom: 4px solid var(--red);
  }
  .detail-inner { max-width: 1100px; margin: 0 auto; }
  .back {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg-dim);
    text-decoration: none;
    border: 2px solid var(--border);
    padding: 0.4em 0.8em;
    display: inline-block;
    margin-bottom: 2rem;
    transition: all 0.1s;
  }
  .back:hover {
    background: var(--red);
    border-color: var(--red);
    color: var(--bg);
  }
  .detail-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .detail-title {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--fg);
    line-height: 1;
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--red);
    color: var(--bg);
    padding: 0.3em 0.8em;
  }
  .detail-oneliner {
    font-size: 1.1rem;
    color: var(--red);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }
  .detail-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .meta-link {
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg);
    text-decoration: none;
    border: 2px solid var(--red);
    padding: 0.5em 1em;
    transition: all 0.1s;
  }
  .meta-link:hover {
    background: var(--red);
    color: var(--bg);
  }

  /* Milestones timeline */
  .milestones {
    display: flex;
    flex-direction: column;
  }
  .milestone {
    display: flex;
    gap: 1.25rem;
    min-height: 3rem;
  }
  .milestone-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 12px;
    flex-shrink: 0;
  }
  .milestone-dot {
    width: 10px;
    height: 10px;
    border: 2px solid var(--border);
    background: var(--bg);
    flex-shrink: 0;
    margin-top: 4px;
  }
  .milestone-dot.latest {
    border-color: var(--red);
    background: var(--red);
  }
  .milestone-line {
    width: 2px;
    flex: 1;
    background: var(--border);
    min-height: 1rem;
  }
  .milestone-content {
    padding-bottom: 1.25rem;
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
  }
  .milestone-date {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: var(--fg-dim);
    white-space: nowrap;
    min-width: 80px;
  }
  .milestone-text {
    font-size: 0.9rem;
    color: var(--fg);
    line-height: 1.5;
  }

  .detail-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--fg);
    max-width: 800px;
  }

  .detail-content {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--fg);
    max-width: 800px;
  }
  .detail-content :global(h2) {
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--red);
    margin: 2rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }
  .detail-content :global(h3) {
    font-size: 1rem;
    font-weight: 900;
    color: var(--fg);
    margin: 1.5rem 0 0.5rem;
  }
  .detail-content :global(p) { margin-bottom: 1rem; }
  .detail-content :global(ul), .detail-content :global(ol) {
    margin: 0 0 1rem 1.5rem;
  }
  .detail-content :global(li) { margin-bottom: 0.5rem; }
  .detail-content :global(img) {
    max-width: 100%;
    border: 2px solid var(--border);
    margin: 1.5rem 0;
  }
  .detail-content :global(code) {
    background: rgba(224, 80, 48, 0.1);
    color: var(--red);
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }
  .detail-content :global(pre) {
    background: #111;
    border: 2px solid var(--border);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .detail-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--fg);
  }
  .detail-content :global(blockquote) {
    border-left: 4px solid var(--red);
    padding-left: 1rem;
    color: var(--fg-dim);
    font-style: italic;
    margin: 1.5rem 0;
  }

  @media (max-width: 700px) {
    .detail-hero { padding: 2rem 1.25rem; }
    .detail-title { font-size: 2rem; }
    .milestone-content { flex-direction: column; gap: 0.25rem; }
  }
</style>
